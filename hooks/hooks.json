{
  "description": "Ships each finished assistant turn to Hive Mind and marks the session complete on exit.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hive_mind.py\" hook",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hive_mind.py\" hook",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
